# SQL Server remoto: complete estos valores con los datos de su instancia.
# Ejemplo: 10.20.30.40 o sql.inppares.org.pe. No use localhost en producción.
DB_HOST=IP_O_NOMBRE_DEL_SERVIDOR_SQL
DB_PORT=1433
DB_NAME=INPPARES_SafeReport
# Use una cuenta exclusiva de la aplicación, nunca sa.
DB_USER=USUARIO_DE_LA_APLICACION
DB_PASSWORD=CAMBIE_ESTA_CONTRASENA
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Pruebas locales con Vite/React. En producción, reemplace por el dominio público.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://172.100.100.231:8080

# Secreto aleatorio de al menos 32 caracteres para firmar las sesiones del panel interno.
ADMIN_SESSION_SECRET=CAMBIE_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO

# Alternativa para despliegues: use una única cadena y omita las variables DB_*.
# DATABASE_URL=mssql+pyodbc://usuario:contrasena@servidor:1433/INPPARES_SafeReport?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
